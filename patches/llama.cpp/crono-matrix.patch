     return home + path.substr(1);
 }
 
+// Normalize and validate a host working directory before it is handed to a
+// subprocess.  The web UI deliberately displays home paths as `~/...`; unlike
+// a shell, subprocess cwd APIs do not expand that shorthand themselves.
+static std::string normalize_host_cwd(const std::string & cwd) {
+    if (cwd.empty()) return cwd;
+
+    const std::string expanded = expand_home(cwd);
+    if (!expanded.empty() && expanded[0] == '~') {
+        throw std::runtime_error("cannot expand tool working directory because the home directory is unknown: " + cwd);
+    }
+
+    std::error_code ec;
+    fs::path full = path_from_utf8(expanded);
+    if (!full.is_absolute()) {
+        full = fs::absolute(full, ec);
+        if (ec) {
+            throw std::runtime_error("cannot resolve tool working directory '" + cwd + "': " + ec.message());
+        }
+    }
+    full = full.lexically_normal();
+
+    if (!fs::is_directory(full, ec) || ec) {
+        throw std::runtime_error("tool working directory does not exist or is not a directory: " + path_to_utf8(full));
+    }
+    return path_to_utf8(full);
+}
