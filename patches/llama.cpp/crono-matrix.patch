+//
+// browser_playwright: navigate and interact through the Playwright dependency
+// shipped with llama-ui. This is a native llama-server tool and does not use MCP.
+//
+
+static constexpr size_t SERVER_TOOL_BROWSER_MAX_OUTPUT = 256 * 1024;
+static constexpr int    SERVER_TOOL_BROWSER_MAX_TIMEOUT = 120;
