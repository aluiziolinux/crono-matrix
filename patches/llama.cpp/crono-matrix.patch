+static std::string browser_playwright_script_path() {
+    if (const char * configured = getenv("LLAMA_PLAYWRIGHT_SCRIPT")) {
+        if (*configured != '\0') {
+            std::error_code ec;
+            if (fs::is_regular_file(path_from_utf8(configured), ec) && !ec) return configured;
+            return {};
+        }
+    }
+
+    std::error_code ec;
+    const fs::path cwd = fs::current_path(ec);
+    if (!ec) {
+        const fs::path candidates[] = {
+            cwd / "tools/server/browser-playwright.mjs",
+            cwd / "llama.cpp/tools/server/browser-playwright.mjs",
+        };
+        for (const auto & candidate : candidates) {
+            if (fs::is_regular_file(candidate, ec) && !ec) return path_to_utf8(candidate);
+            ec.clear();
+        }
+    }
+    return {};
+}
