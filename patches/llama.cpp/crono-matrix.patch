+                                        {"enum", json::array({"click", "fill", "type", "press", "wait_for_selector", "wait_for_text", "scroll"})},
+                                    }},
+                                    {"selector", {{"type", "string"}}},
+                                    {"text", {{"type", "string"}}},
+                                    {"key", {{"type", "string"}}},
+                                    {"x", {{"type", "number"}}},
+                                    {"y", {{"type", "number"}}},
+                                    {"delay", {{"type", "integer"}}},
+                                    {"timeout", {{"type", "integer"}}},
+                                    {"state", {{"type", "string"}, {"enum", json::array({"attached", "detached", "visible", "hidden"})}}},
+                                    {"exact", {{"type", "boolean"}}},
+                                }},
+                                {"required", json::array({"type"})},
+                            }},
+                        }},
+                        {"screenshot_path", {{"type", "string"}, {"description", "Optional output path for a PNG screenshot"}}},
+                        {"full_page", {{"type", "boolean"}, {"description", "Capture the full page when screenshot_path is set"}}},
+                    }},
+                    {"required", json::array({"url"})},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json params, server_tool::stream *) const override {
+        if (!json_value(params, "runtime", std::string()).empty()) {
+            return {{"error", "browser_playwright runs on the host and is not available through --tools-runtime"}};
+        }
+
+        const std::string script = browser_playwright_script_path();
+        if (script.empty()) {
+            return {{"error",
+                "Playwright helper not found; set LLAMA_PLAYWRIGHT_SCRIPT to tools/server/browser-playwright.mjs"}};
+        }
+
+        const char * node_env = getenv("LLAMA_PLAYWRIGHT_NODE");
+        const std::string node = node_env && *node_env ? node_env : "node";
+        const std::string cwd = normalize_host_cwd(json_value(params, "cwd", std::string()));
+        int timeout_ms = json_value(params, "timeout", 30000);
+        timeout_ms = std::max(1000, std::min(timeout_ms, SERVER_TOOL_BROWSER_MAX_TIMEOUT * 1000));
+        const int process_timeout = std::min(
+            SERVER_TOOL_BROWSER_MAX_TIMEOUT,
+            std::max(10, timeout_ms / 1000 + 10));
+
+        params.erase("cwd");
+        params.erase("runtime");
+        const std::string input = safe_json_to_str(params);
+        auto res = run_subprocess(
+            {node, script}, SERVER_TOOL_BROWSER_MAX_OUTPUT, process_timeout,
+            nullptr, /*combine_stderr=*/false, cwd, &input);
+
+        json output;
+        try {
+            output = json::parse(res.output);
+        } catch (...) {
+            return {{"error", string_format(
+                "browser_playwright returned invalid JSON (exit code %d%s)",
+                res.exit_code, res.timed_out ? ", timed out" : "")}};
+        }
+
+        if (res.exit_code != 0 || res.timed_out || !json_value(output, "ok", false)) {
+            return {{"error", json_value(output, "error", std::string("browser_playwright failed"))}};
+        }
+        return output;
+    }
