diff --git a/src/meta-head.cpp b/src/meta-head.cpp
new file mode 100644
index 000000000..cef2bf06e
--- /dev/null
+++ b/src/meta-head.cpp
@@ -0,0 +1,192 @@
+#include "meta-head.h"
+#include "gguf.h"
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include <vector>
+
+static void layer_norm(const float * inp, const float * w, const float * b, int d, float * out) {
+    float mean = 0;
+    for (int i = 0; i < d; i++) mean += inp[i];
+    mean /= d;
+    float var = 0;
+    for (int i = 0; i < d; i++) { float diff = inp[i] - mean; var += diff * diff; }
+    var = var / d + 1e-6f;
+    float inv_std = 1.0f / sqrtf(var);
+    for (int i = 0; i < d; i++) out[i] = (inp[i] - mean) * inv_std * w[i] + b[i];
+}
+
+static void linear(const float * inp, const float * w, const float * b, int in_dim, int out_dim, float * out) {
+    // w layout: [out_dim, in_dim] (PyTorch format, row-major in blob)
+    // y[i] = sum_j(inp[j] * w[i*in_dim + j]) + b[i]
+    for (int i = 0; i < out_dim; i++) {
+        float sum = b[i];
+        for (int j = 0; j < in_dim; j++) sum += inp[j] * w[i * in_dim + j];
+        out[i] = sum;
+    }
+}
+
+static void silu_inplace(float * x, int n) {
+    for (int i = 0; i < n; i++) {
+        float sig = 1.0f / (1.0f + expf(-x[i]));
+        x[i] = x[i] * sig;
+    }
+}
+
+bool llama_meta_head::load_from_gguf_kv(const struct gguf_context * ctx) {
+    const int n_kv = gguf_get_n_kv(ctx);
+
+    bool found = false;
+    for (int i = 0; i < n_kv; i++) {
+        if (strcmp(gguf_get_key(ctx, i), "ornith.meta_head.version") == 0) { found = true; break; }
+    }
+    if (!found) return false;
+
+    for (int i = 0; i < n_kv; i++) {
+        const char * key = gguf_get_key(ctx, i);
+        if (strcmp(key, "ornith.meta_head.head_size") == 0)
+            head_size = (int32_t)gguf_get_val_u32(ctx, i);
+        else if (strcmp(key, "ornith.meta_head.num_actions") == 0)
+            num_actions = (int32_t)gguf_get_val_u32(ctx, i);
+        else if (strcmp(key, "ornith.meta_head.confidence_threshold") == 0)
+            confidence_threshold = gguf_get_val_f32(ctx, i);
+    }
+
+    const uint8_t * blob_data = nullptr;
+    uint64_t blob_size = 0;
+    for (int i = 0; i < n_kv; i++) {
+        if (strcmp(gguf_get_key(ctx, i), "ornith.meta_head.weights_blob") == 0
+            && gguf_get_kv_type(ctx, i) == GGUF_TYPE_ARRAY) {
+            blob_size = gguf_get_arr_n(ctx, i);
+            blob_data = (const uint8_t *)gguf_get_arr_data(ctx, i);
+            break;
+        }
+    }
+
+    if (!blob_data || blob_size < 8000000) return false;
+
+    // Blob stored as byte values in i32 array — pack 4 i32s into 1 float
+    const int32_t * blob_ints = (const int32_t *)blob_data;
+    size_t idx = 0;  // float index
+    auto copyf = [&](int n) {
+        float * p = (float *)malloc(n * sizeof(float));
+        for (int k = 0; k < n; k++) {
+            uint32_t b0 = (uint32_t)(blob_ints[idx * 4 + 0] & 0xFF);
+            uint32_t b1 = (uint32_t)(blob_ints[idx * 4 + 1] & 0xFF);
+            uint32_t b2 = (uint32_t)(blob_ints[idx * 4 + 2] & 0xFF);
+            uint32_t b3 = (uint32_t)(blob_ints[idx * 4 + 3] & 0xFF);
+            uint32_t packed = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
+            p[k] = reinterpret_cast<const float &>(packed);
+            idx++;
+        }
+        return p;
+    };
+
+    ln_wf     = copyf(4096);
+    ln_bf     = copyf(4096);
+    dense_wf  = copyf(512 * 4096);
+    dense_bf  = copyf(512);
+    action_wf = copyf(5 * 512);
+    action_bf = copyf(5);
+    conf_wf   = copyf(1 * 512);
+    conf_bf   = copyf(1);
+
+    enabled = true;
+    fprintf(stderr, "meta_head: loaded %zu floats (%zu bytes), enabled=%d\n", idx, idx * sizeof(float), enabled);
+    return true;
+}
+
+void llama_meta_head::build_backend() {
+    // no-op for pure C++ path
+}
+
+llama_meta_head::~llama_meta_head() {
+    free(ln_wf); free(ln_bf);
+    free(dense_wf); free(dense_bf);
+    free(action_wf); free(action_bf);
+    free(conf_wf); free(conf_bf);
+}
+
+llama_meta_output llama_meta_head::forward(const float * hidden_state) const {
+    llama_meta_output out = {};
+    out.action = llama_meta_action::ABSTAIN;
+    if (!enabled) return out;
+
+    // LayerNorm
+    std::vector<float> norm(4096);
+    layer_norm(hidden_state, ln_wf, ln_bf, 4096, norm.data());
+
+    // Dense 4096 → 512
+    std::vector<float> d512(512);
+    linear(norm.data(), dense_wf, dense_bf, 4096, 512, d512.data());
+
+    // SiLU
+    silu_inplace(d512.data(), 512);
+
+    // Action head: 512 → 5
+    float act_raw[5];
+    linear(d512.data(), action_wf, action_bf, 512, 5, act_raw);
+    for (int i = 0; i < 5; i++) out.action_probs[i] = act_raw[i];
+
+    // Softmax
+    float max_v = act_raw[0]; int max_i = 0;
+    for (int i = 1; i < 5; i++) if (act_raw[i] > max_v) { max_v = act_raw[i]; max_i = i; }
+    float sum = 0;
+    for (int i = 0; i < 5; i++) { out.action_probs[i] = expf(act_raw[i] - max_v); sum += out.action_probs[i]; }
+    for (int i = 0; i < 5; i++) out.action_probs[i] /= sum;
+    out.action = (llama_meta_action)max_i;
+
+    // Confidence head: 512 → 1 → sigmoid
+    float conf_raw[1];
+    linear(d512.data(), conf_wf, conf_bf, 512, 1, conf_raw);
+    out.confidence = 1.0f / (1.0f + expf(-conf_raw[0]));
+
+    out.accepted = (out.action == llama_meta_action::ACCEPT) && (out.confidence > confidence_threshold);
+    return out;
+}
+
+bool llama_meta_head::build_graph(
+    struct ggml_context * ctx,
+    struct ggml_tensor * hidden,
+    int il,
+    struct ggml_tensor *& t_meta_out,
+    const std::vector<ggml_tensor *> & persistent_tensors) const {
+
+    if (!enabled || persistent_tensors.size() < 8) return false;
+
+    auto * ln_w = persistent_tensors[0];
+    auto * ln_b = persistent_tensors[1];
+    auto * d_w  = persistent_tensors[2];
+    auto * d_b  = persistent_tensors[3];
+    auto * a_w  = persistent_tensors[4];
+    auto * a_b  = persistent_tensors[5];
+    auto * c_w  = persistent_tensors[6];
+    auto * c_b  = persistent_tensors[7];
+
+    // LayerNorm: hidden [4096, n_tok] → norm [4096, n_tok]
+    auto * x = ggml_norm(ctx, hidden, 1e-6f);
+    x = ggml_mul(ctx, x, ln_w);
+    x = ggml_add(ctx, x, ln_b);
+
+    // Dense: [4096, n_tok] → [512, n_tok]
+    x = ggml_mul_mat(ctx, d_w, x);
+    x = ggml_add(ctx, x, d_b);
+
+    // SiLU
+    x = ggml_silu(ctx, x);
+
+    // Action head: [512, n_tok] → [5, n_tok]
+    auto * act = ggml_mul_mat(ctx, a_w, x);
+    act = ggml_add(ctx, act, a_b);
+
+    // Confidence head: [512, n_tok] → [1, n_tok]
+    auto * conf = ggml_mul_mat(ctx, c_w, x);
+    conf = ggml_add(ctx, conf, c_b);
+
+    // Concatenate: [5, n_tok] + [1, n_tok] → [6, n_tok]
+    t_meta_out = ggml_concat(ctx, act, conf, 0);
+    ggml_set_name(t_meta_out, "meta_out");
+
+    return true;
+}
diff --git a/src/meta-head.h b/src/meta-head.h
new file mode 100644
index 000000000..929fdfeaa
--- /dev/null
+++ b/src/meta-head.h
@@ -0,0 +1,78 @@
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include <cstdint>
+#include <vector>
+
+// ── MetaCognitive Actions ──────────────────────────────────
+enum class llama_meta_action {
+    ACCEPT      = 0,
+    REVISE      = 1,
+    VERIFY      = 2,
+    REGENERATE  = 3,
+    ABSTAIN     = 4,
+};
+
+inline const char * llama_meta_action_name(llama_meta_action a) {
+    switch (a) {
+        case llama_meta_action::ACCEPT:     return "ACCEPT";
+        case llama_meta_action::REVISE:     return "REVISE";
+        case llama_meta_action::VERIFY:     return "VERIFY";
+        case llama_meta_action::REGENERATE: return "REGENERATE";
+        case llama_meta_action::ABSTAIN:    return "ABSTAIN";
+        default: return "UNKNOWN";
+    }
+}
+
+// ── Output ─────────────────────────────────────────────────
+struct llama_meta_output {
+    llama_meta_action action;
+    float action_probs[5];
+    float confidence;
+    bool  accepted;
+};
+
+// ── Head Structure ─────────────────────────────────────────
+struct llama_meta_head {
+    bool enabled = false;
+
+    int32_t head_size    = 512;
+    int32_t num_actions  = 5;
+    float   confidence_threshold = 0.7f;
+
+    struct ggml_tensor * ln_w   = nullptr;
+    struct ggml_tensor * ln_b   = nullptr;
+    struct ggml_tensor * dense_w = nullptr;
+    struct ggml_tensor * dense_b = nullptr;
+    struct ggml_tensor * action_w = nullptr;
+    struct ggml_tensor * action_b = nullptr;
+    struct ggml_tensor * conf_w   = nullptr;
+    struct ggml_tensor * conf_b   = nullptr;
+
+    // Pure C++ weights (fallback)
+    float * ln_wf      = nullptr;
+    float * ln_bf      = nullptr;
+    float * dense_wf   = nullptr;
+    float * dense_bf   = nullptr;
+    float * action_wf  = nullptr;
+    float * action_bf  = nullptr;
+    float * conf_wf    = nullptr;
+    float * conf_bf    = nullptr;
+
+    ggml_backend_t backend    = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+
+    // Pure C++ weights (primary path)
+
+    bool load_from_gguf_kv(const struct gguf_context * ctx);
+    void build_backend();
+    llama_meta_output forward(const float * hidden_state) const;
+
+    // Build meta head as ggml graph nodes using pre-allocated persistent tensors
+    // t_hidden [n_embd, n_tokens] → t_meta_out [6, n_tokens]
+    bool build_graph(struct ggml_context * ctx, struct ggml_tensor * hidden, int il,
+                     struct ggml_tensor *& t_meta_out,
+                     const std::vector<ggml_tensor *> & persistent_tensors) const;
+    ~llama_meta_head();
+};
