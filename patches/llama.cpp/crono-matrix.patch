diff --git a/tools/meta-extract/meta-extract.cpp b/tools/meta-extract/meta-extract.cpp
new file mode 100644
index 000000000..e0f784bac
--- /dev/null
+++ b/tools/meta-extract/meta-extract.cpp
@@ -0,0 +1,125 @@
+// Extract last hidden state from GGUF model for MetaCognitiveHead training
+// Usage: ./build/bin/meta-extract model.gguf train.jsonl output_prefix
+#include "common.h"
+#include "llama.h"
+#include "llama-ext.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <string>
+#include <fstream>
+#include <map>
+
+int main(int argc, char ** argv) {
+    if (argc < 3) {
+        fprintf(stderr, "Usage: %s model.gguf train.jsonl [output_prefix]\n", argv[0]);
+        return 1;
+    }
+    const char * model_path = argv[1];
+    const char * jsonl_path = argv[2];
+    const char * out_prefix  = argc > 3 ? argv[3] : "meta_train";
+
+    llama_backend_init();
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = 0; // CPU-only to avoid VRAM competition with server
+    llama_model * model = llama_model_load_from_file(model_path, mparams);
+    if (!model) { fprintf(stderr, "Failed to load model\n"); return 1; }
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx = 2048;
+    cparams.n_batch = 512;
+    cparams.n_ubatch = 512;
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (!ctx) { fprintf(stderr, "Failed to create context\n"); return 1; }
+
+    // Read samples
+    std::vector<std::string> lines;
+    { std::ifstream f(jsonl_path); std::string line;
+      while (std::getline(f, line)) { if (!line.empty() && line[0]=='{') lines.push_back(line); } }
+    fprintf(stderr, "Samples: %zu\n", lines.size());
+
+    // Open output
+    std::string h_path = std::string(out_prefix) + "_hiddens.f32";
+    std::string l_path = std::string(out_prefix) + "_labels.i32";
+    FILE * f_h = fopen(h_path.c_str(), "wb");
+    FILE * f_l = fopen(l_path.c_str(), "wb");
+    if (!f_h || !f_l) { fprintf(stderr, "Cannot open output\n"); return 1; }
+
+    int32_t n_embd = llama_model_n_embd_out(model);
+    fwrite(&n_embd, sizeof(int32_t), 1, f_h);
+    int32_t zero = 0; fwrite(&zero, sizeof(int32_t), 1, f_h);
+
+    std::map<std::string, int> act_map = {
+        {"ACCEPT",0},{"REVISE",1},{"VERIFY",2},{"REGENERATE",3},{"ABSTAIN",4}};
+
+    auto jget = [](const std::string & l, const char * k, std::string & v) {
+        std::string q = std::string("\"") + k + "\"";
+        size_t p = l.find(q); if (p==std::string::npos) return false;
+        p = l.find('"', p+q.size()); if (p==std::string::npos) return false;
+        p++; size_t e = l.find('"', p); if (e==std::string::npos) return false;
+        v = l.substr(p, e-p); return true;
+    };
+    auto jgetf = [](const std::string & l, const char * k, float d) {
+        std::string q = std::string("\"") + k + "\"";
+        size_t p = l.find(q); if (p==std::string::npos) return d;
+        p = l.find(':', p+q.size()); if (p==std::string::npos) return d;
+        p++; while (p<l.size() && (l[p]==' '||l[p]=='\t')) p++;
+        return (float)atof(l.c_str()+p);
+    };
+
+    int32_t n_samples = 0;
+    for (size_t s = 0; s < lines.size(); s++) {
+        std::string prompt, draft, action;
+        if (!jget(lines[s], "prompt", prompt)) continue;
+        if (!jget(lines[s], "draft", draft))   continue;
+        if (!jget(lines[s], "action", action)) continue;
+        float conf = jgetf(lines[s], "confidence", 0.5f);
+
+        if (s % 20 == 0) fprintf(stderr, "  [%zu/%zu]\n", s, lines.size());
+
+        // Build text with CoT wrapper (truncate draft to avoid overflow)
+        std::string d = draft.size() > 400 ? draft.substr(0, 400) : draft;
+        std::string text = "<|im_start|>user\n" + prompt +
+            "<|im_end|>\n<|im_start|>assistant\n<think>\n" + d +
+            "\n</think>\n\n" + d + "<|im_end|>";
+
+        std::vector<llama_token> toks = common_tokenize(ctx, text.c_str(), true, true);
+        if (toks.size() < 2) continue;
+        if (toks.size() > 2048) {
+            toks.resize(2048); // hard limit
+        }
+
+        llama_batch batch = llama_batch_get_one(toks.data(), (int32_t)toks.size());
+        // llama_decode works for both encode (first batch) and decode (subsequent batches)
+        int ret = llama_decode(ctx, batch);
+        if (ret != 0 && ret != 1) {
+            fprintf(stderr, "  decode failed ret=%d\n", ret);
+            llama_memory_clear(llama_get_memory(ctx), true);
+            continue;
+        }
+
+        const float * hidden = llama_get_last_hidden_state(ctx);
+        if (!hidden) continue;
+
+        fwrite(hidden, sizeof(float), n_embd, f_h);
+        int aid = act_map.count(action) ? act_map[action] : 0;
+        fwrite(&aid, sizeof(int32_t), 1, f_l);
+        fwrite(&conf, sizeof(float), 1, f_l);
+        fflush(f_h); fflush(f_l);
+        n_samples++;
+
+        llama_memory_clear(llama_get_memory(ctx), true);
+    }
+
+    fseek(f_h, sizeof(int32_t), SEEK_SET);
+    fwrite(&n_samples, sizeof(int32_t), 1, f_h);
+    fclose(f_h); fclose(f_l);
+
+    fprintf(stderr, "\nDone: %d samples\n%s\n%s\n", n_samples, h_path.c_str(), l_path.c_str());
+
+    llama_free(ctx);
+    llama_model_free(model);
+    llama_backend_free();
+    return 0;
+}
