+                {"name", name},
+                {"description",
+                    "Open an HTTP/HTTPS/data URL, file:// URL, or local HTML file path in a real headless Chromium "
+                    "using Playwright. Optionally interact with it and return title, visible text, links, browser "
+                    "console messages, page errors and failed requests. A missing local path is a target error, not "
+                    "a browser infrastructure failure. Use screenshot_path to save an image that can then be "
+                    "inspected with read_media on vision models."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", {
+                        {"url", {{"type", "string"}, {"description", "HTTP, HTTPS, data or file URL, or a local HTML path relative to the conversation working directory"}}},
+                        {"wait_until", {
+                            {"type", "string"},
+                            {"enum", json::array({"commit", "domcontentloaded", "load", "networkidle"})},
+                            {"description", "Navigation readiness event (default: domcontentloaded)"},
+                        }},
+                        {"timeout", {{"type", "integer"}, {"description", "Timeout in milliseconds (default 30000, max 120000)"}}},
+                        {"max_text_chars", {{"type", "integer"}, {"description", "Maximum visible text returned (default 12000, max 64000)"}}},
+                        {"locale", {{"type", "string"}, {"description", "Browser locale (default pt-BR)"}}},
+                        {"actions", {
+                            {"type", "array"},
+                            {"maxItems", 20},
+                            {"description", "Ordered browser actions"},
+                            {"items", {
