# Diretórios opcionais. Se omitidos, o launcher usa caminhos relativos ao projeto.
CRONO_LLAMA_CPP_DIR=
CRONO_LLAMA_SERVER=
CRONO_GGUF_PY_DIR=
CRONO_MODELS_DIR=
CRONO_MEDIA_PATH=

# Arquivos de estado podem ser redirecionados sem alterar o código.
CRONO_AUTOTUNE_CACHE=

# Mantenha 127.0.0.1 para não expor ferramentas nativas sem autenticação.
CRONO_HOST=127.0.0.1
CRONO_PORT=8080
